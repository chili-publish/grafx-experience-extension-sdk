{
  "name": "@chili-publish/grafx-experience-extension-sdk",
  "version": "0.3.1",
  "description": "Helpers for building GraFx Experience extensions",
  "keywords": [
    "chili-publish",
    "grafx",
    "sdk",
    "extension",
    "browser"
  ],
  "homepage": "https://github.com/chili-publish/grafx-experience-extension-sdk#readme",
  "bugs": {
    "url": "https://github.com/chili-publish/grafx-experience-extension-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chili-publish/grafx-experience-extension-sdk.git"
  },
  "license": "MIT",
  "author": "chili-publish",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/extension-sdk.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/extension-sdk.cjs"
      }
    }
  },
  "main": "./dist/extension-sdk.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.lib.json --noEmit && vite build",
    "preview": "vite preview",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "check:types": "npx --yes @arethetypeswrong/cli --pack .",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "version-packages:snapshot": "changeset version --snapshot canary",
    "release": "changeset publish",
    "release:canary": "changeset publish --tag canary --no-git-tag",
    "release:rc:enter": "changeset pre enter rc && node scripts/sync-rc-banner.mjs enter",
    "release:rc:exit": "changeset pre exit && node scripts/sync-rc-banner.mjs exit",
    "prepublishOnly": "npm run build && npm run check:types"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "sideEffects": false,
  "module": "./dist/extension-sdk.js"
}
